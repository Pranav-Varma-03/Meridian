[Unit]
Description=Meridian Grafana Alloy telemetry gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meridian
Group=meridian
EnvironmentFile=/etc/meridian/grafana-alloy.env
ExecStart=/usr/local/bin/alloy run /opt/meridian/observability/alloy/config.alloy --server.http.listen-addr=127.0.0.1:12345
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/alloy

[Install]
WantedBy=multi-user.target
