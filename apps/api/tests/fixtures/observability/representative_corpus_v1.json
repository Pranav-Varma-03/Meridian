{
  "version": "representative_corpus_v1",
  "classification": "de-identified-disposable",
  "source_fixture_directory": "../retrieval_evaluation/documents",
  "document_set": [
    "travel-policy.txt",
    "contract.txt",
    "pricing.txt",
    "exception-policy.txt",
    "msa.txt",
    "retention-policy-a.txt",
    "retention-policy-b.txt",
    "onboarding-guide.txt",
    "onboarding-checklist.txt",
    "employee-handbook.txt"
  ],
  "owner_profiles": [
    {"name": "small", "owners": 10, "documents_per_owner": 10, "replicas_per_document": 1},
    {"name": "expected", "owners": 25, "documents_per_owner": 20, "replicas_per_document": 2},
    {"name": "burst", "owners": 50, "documents_per_owner": 30, "replicas_per_document": 3}
