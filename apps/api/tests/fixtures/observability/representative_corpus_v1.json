  "acceptance_measurements": [
    "p50_latency_ms",
    "p95_latency_ms",
    "p99_latency_ms",
    "error_rate",
    "timeout_rate",
    "connection_pool_saturation",
    "selected_query_plan_indexes",
    "active_metric_series"
  ]
