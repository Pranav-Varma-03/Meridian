# ═══════════════════════════════════════════════
# Meridian RAG - Environment Variables
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════

# ─────────────────────────────────────────────────
# OpenAI (Optional)
# ─────────────────────────────────────────────────
# Required only when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=<your-openai-api-key>

# ─────────────────────────────────────────────────
# App Runtime
# ─────────────────────────────────────────────────
APP_NAME=Meridian API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000
# The browser never reads API_BASE_URL. Next.js uses it server-side through the
# same-origin /api/meridian/* BFF routes, which obtain the Auth0 API token from the
# encrypted server session. Do not expose this as NEXT_PUBLIC_API_BASE_URL.
# ─────────────────────────────────────────────────
# Pinecone (Required for vector storage)
# Get from: https://app.pinecone.io
# ─────────────────────────────────────────────────
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=<your-pinecone-index-name>
# Purge workers delete vectors asynchronously in bounded batches after logical deletion.
PINECONE_VECTOR_DELETE_BATCH_SIZE=100
PINECONE_VECTOR_DELETE_TIMEOUT_SECONDS=5
PINECONE_VECTOR_DELETE_MAX_ATTEMPTS=3
# ─────────────────────────────────────────────────
# Embedding Provider (Required)
# Set provider/model pair via env only (portable plug-and-play)
# Examples:
#   EMBEDDING_PROVIDER=pinecone
#   EMBEDDING_MODEL=llama-text-embed-v2
# or
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=text-embedding-3-small
# ─────────────────────────────────────────────────
EMBEDDING_PROVIDER=pinecone
EMBEDDING_MODEL=llama-text-embed-v2
# Required for llama-text-embed-v2 (use `passage` for indexing, `query` for search)
EMBEDDING_INPUT_TYPE=passage
# Enable contextual chunk enrichment before embedding (native code path, no external API call yet)
CONTEXTUAL_EMBEDDING_ENABLED=false
# Options: native | openai
CONTEXTUAL_CHUNKING_PROVIDER=native
# Required when CONTEXTUAL_EMBEDDING_ENABLED=true and CONTEXTUAL_CHUNKING_PROVIDER=openai
# Example: gpt-4o-mini
# CONTEXTUAL_CHUNKING_MODEL=

# ─────────────────────────────────────────────────
# Grounded Chat (OpenRouter generation)
# ─────────────────────────────────────────────────
# Get an API key from https://openrouter.ai/keys. `openrouter/free` routes each
# request to a compatible free model. OpenAI is not used for chat generation.
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openrouter/free
CHAT_TEMPERATURE=0.2
CHAT_MAX_OUTPUT_TOKENS=800
CHAT_CONTEXT_BUDGET_TOKENS=6000
# Input capacity is min(CONTEXT_BUDGET, CONTEXT_WINDOW - MAX_OUTPUT - SAFETY_RESERVE).
CHAT_CONTEXT_WINDOW_TOKENS=16000
CHAT_SAFETY_RESERVE_TOKENS=512
CHAT_SUMMARY_MAX_TOKENS=1000
CHAT_HISTORY_MAX_TOKENS=1800
CHAT_SOURCE_MIN_TOKENS=1200
CHAT_SOURCE_MAX_TOKENS=4000
CHAT_RETRIEVAL_TOP_K=12
CHAT_RETRIEVAL_OVERFETCH=3
CHAT_RETRIEVAL_MAX_SOURCES=6
CHAT_RETRIEVAL_SCORE_THRESHOLD=0.2
CHAT_HISTORY_MAX_MESSAGES=8
CHAT_SOURCE_PER_DOCUMENT_LIMIT=2
# Optional model overrides; default to CHAT_MODEL when unset.
# CHAT_SUMMARY_MODEL=
# CHAT_REWRITE_MODEL=

# ─────────────────────────────────────────────────
# Auth0 (Required for authentication)
# Get from: https://manage.auth0.com
# ─────────────────────────────────────────────────
AUTH0_DOMAIN=<your-auth0-tenant-domain>
AUTH0_CLIENT_ID=<your-auth0-client-id>
AUTH0_CLIENT_SECRET=<your-auth0-client-secret>
AUTH0_AUDIENCE=<your-auth0-api-identifier>
AUTH0_SECRET=<generate-with-openssl-rand-hex-32>
# OIDC identity scopes for the web application. API permissions are granted
# through Auth0 RBAC and arrive in the access-token `permissions` claim.
AUTH0_SCOPE=openid profile email

# ─────────────────────────────────────────────────
# PostgreSQL Database (Supabase recommended)
# Get from: https://supabase.com/dashboard/project/_/settings/database
# ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://<db-user>:<db-password>@<db-host>:<db-port>/<db-name>?sslmode=require

# ─────────────────────────────────────────────────
# Redis (Upstash recommended)
# Get from: https://console.upstash.com
# ─────────────────────────────────────────────────
REDIS_URL=rediss://<redis-username>:<redis-password>@<redis-host>:<redis-port>
INGESTION_QUEUE_KEY=ingestion:jobs
INGESTION_WORKER_DEQUEUE_TIMEOUT_SECONDS=5
INGESTION_WORKER_MAX_ATTEMPTS=3
INGESTION_WORKER_IDLE_SLEEP_SECONDS=1.0
# Durable ingestion retry: full-jitter exponential backoff, capped at this delay.
INGESTION_RETRY_BASE_SECONDS=1.0
INGESTION_RETRY_MAX_SECONDS=300
# A processing ingestion job left beyond this lease is recovered by the worker.
INGESTION_WORKER_STUCK_TIMEOUT_SECONDS=900
# A purge job left running beyond this duration is returned to retryable state.
PURGE_WORKER_STUCK_TIMEOUT_SECONDS=900
# Production protection for cost-bearing authenticated routes. Redis is required
# while enabled; when it is unavailable Meridian returns 503 instead of failing open.
RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_REQUESTS=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
# ─────────────────────────────────────────────────
# File Storage (Cloudflare R2 or AWS S3)
# ─────────────────────────────────────────────────
# S3_BUCKET=meridian-documents
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT_URL=https://xxx.r2.cloudflarestorage.com

# ─────────────────────────────────────────────────
# Optional: Monitoring & Logging
# ─────────────────────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn
# AXIOM_TOKEN=your-axiom-token
# AXIOM_DATASET=meridian-logs
